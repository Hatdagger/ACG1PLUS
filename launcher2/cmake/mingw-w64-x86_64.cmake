# Cross-compiling the Windows launcher on Linux with llvm-mingw
# (https://github.com/mstorsjo/llvm-mingw). LLVM_MINGW = its unpacked folder.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT LLVM_MINGW)
    set(LLVM_MINGW "$ENV{LLVM_MINGW}")
endif()
set(_p "${LLVM_MINGW}/bin/x86_64-w64-mingw32")
set(CMAKE_C_COMPILER   "${_p}-clang")
set(CMAKE_CXX_COMPILER "${_p}-clang++")
set(CMAKE_RC_COMPILER  "${_p}-windres")
set(CMAKE_AR           "${LLVM_MINGW}/bin/llvm-ar")
set(CMAKE_RANLIB       "${LLVM_MINGW}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
